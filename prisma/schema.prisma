generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// admin  = administrador da plataforma (nao pertence a uma agencia)
// owner  = dono da agencia (antigo "profissional")
// editor = membro convidado da agencia
enum UserRole {
  admin
  owner
  editor
}

enum UserStatus {
  ativo
  suspenso
}

// Plano de assinatura da conta (agencia). Controla limites de uso e acesso
// a features (ver PlansService/PLAN_LIMITS em src/plans/). Sem gateway de
// pagamento integrado ainda: a troca de plano hoje e manual, via endpoint
// admin (PATCH /admin/accounts/:id/plan).
enum Plan {
  portfolio
  free
  pro
  agencia
}

enum VideoStatus {
  pendente
  aprovado
  ajuste
  erro
}

// Etapa de producao interna da agencia (board Kanban) - independente do
// VideoStatus, que reflete a decisao do cliente na tela publica. Ex: um
// video pode estar "em_edicao" antes mesmo de ir pro cliente, ou "entregue"
// depois de aprovado. Ver VideosService.updateEtapa / PATCH /videos/:id/etapa.
enum EtapaProducao {
  planejado
  producao
  edicao
  aguardando_aprovacao
  ajustes
  aprovado
  entregue
}

enum ProcessamentoStatus {
  processando
  pronto
  erro
}

// Tipo de midia de um item de portfolio - foto nao passa pelo pipeline de
// thumbnail/otimizacao (ver PortfolioVideo.tipoMidia).
enum PortfolioMediaType {
  video
  foto
  design
}

enum InviteStatus {
  pendente
  aceito
  cancelado
}

// Canal do comentario: cliente (conversa com o cliente externo) e
// interno (conversa privada da agencia, nunca visivel pro cliente).
enum CommentChannel {
  cliente
  interno
}

// Quem escreveu: cliente (externo, sem login) ou owner/editor da agencia.
enum CommentAuthorType {
  owner
  editor
  cliente
}

// Tipo de evento registrado na trilha de auditoria do cliente (ver
// ClientActivity). Append-only - alimenta GET /clients/:id/activity na
// central do cliente do frontend.
enum ClientActivityType {
  video_enviado
  aprovacao_cliente
  ajuste_solicitado
  comentario_cliente
  resposta_agencia
  nova_versao
  arquivo_enviado
  arquivo_removido
  // Reservado para uma futura feature de nota interna do cliente - nao
  // ha campo/rota que emita este tipo ainda.
  nota_atualizada
}

// Quem gerou o evento de ClientActivity.
enum ClientActivityAtorTipo {
  cliente
  owner
  editor
  sistema
}

// Categoria do arquivo operacional do cliente (ver ClientFile) - livre,
// so orienta a exibicao no frontend.
enum ClientFileCategoria {
  briefing
  contrato
  referencia
  roteiro
  outro
}

enum CheckDayNoteVisibilidade {
  equipe
  privada
}

// Cores disponiveis para as labels internas do Kanban. O frontend usa estes
// identificadores para aplicar sua propria paleta visual.
enum LabelColor {
  red
  orange
  amber
  emerald
  sky
  violet
  pink
}

// Eventos do cliente que geram notificacao para o owner/editor responsavel.
enum NotificationType {
  comentario_cliente
  aprovacao_cliente
  ajuste_solicitado
  avaliacao_cliente
  // Lembrete de gravacao proxima (RecordingEvent) - so pro owner, ver
  // NotificationsService.sendRecordingReminders.
  lembrete_gravacao
}

// Conta = agencia. Agrupa os usuarios (owner + editores) e todos os
// clientes/projetos compartilhados por eles.
model Account {
  id                  String   @id @default(uuid())
  nomeAgencia         String   @map("nome_agencia")
  plan                Plan     @default(free)
  // Documento do owner cobrado (CPF ou CNPJ, apenas digitos). Exigido pela
  // Asaas para criar o Customer — coletado no primeiro checkout e
  // reaproveitado nos seguintes. Ver src/billing/billing.service.ts.
  cpfCnpj             String?  @map("cpf_cnpj")
  // Assinatura paga (Asaas). asaasCustomerId identifica o Customer (criado
  // uma vez, reaproveitado); asaasSubscriptionId identifica a Subscription
  // ativa, nula ate a primeira assinatura ser confirmada pelo webhook — ver
  // src/billing/billing.service.ts.
  asaasCustomerId     String?  @map("asaas_customer_id")
  asaasSubscriptionId String?  @unique @map("asaas_subscription_id")
  criadoEm            DateTime @default(now()) @map("criado_em")

  memberships         Membership[]
  clients             Client[]
  projects            Project[]
  invites             Invite[]
  ratingQuestions     RatingQuestion[]
  notifications       Notification[]
  recordingEvents     RecordingEvent[]
  crewMembers         CrewMember[]
  portfolios          Portfolio[]
  portfolioCategories PortfolioCategory[]
  portfolioProfile    PortfolioProfile?
  demandas            Demanda[]
  clientActivities    ClientActivity[]
  clientFiles         ClientFile[]
  checkDayNotes       CheckDayNote[]
  labels              Label[]

  clientFields        ClientField[]
  @@map("accounts")
}

// Identidade global (login) do usuario, independente de agencia. O vinculo
// com cada agencia (papel, status) vive em Membership - um User pode ter
// zero ou mais Memberships (ver Membership). role/status aqui nao sao mais
// por-agencia: role so importa para o valor "admin" (staff da plataforma,
// ver RolesGuard) e status e um banimento global (ver
// AdminService.setUserStatus), distinto da suspensao dentro de uma agencia
// especifica (Membership.status, ver AccountService.setMemberStatus).
model User {
  id                String     @id @default(uuid())
  nome              String
  email             String     @unique
  // Opcional: contas criadas via login social (Google/Apple) nao tem senha local.
  senha             String?
  // Identificadores de login social. Uma conta pode ter senha local e/ou
  // um ou ambos vinculados (login por qualquer um deles cai no mesmo User).
  googleId          String?    @unique @map("google_id")
  appleId           String?    @unique @map("apple_id")
  avatarUrl         String?    @map("avatar_url")
  role              UserRole   @default(owner)
  status            UserStatus @default(ativo)
  // White label da agencia: logo e cor de destaque (hex) exibidos na tela do cliente
  logoUrl           String?    @map("logo_url")
  corDestaque       String?    @map("cor_destaque")
  criadoEm          DateTime   @default(now()) @map("criado_em")
  // Null = ainda nao confirmou o email. Preenchido na hora da criacao para
  // contas via Google/Apple (o provider ja verificou), ou ao consumir um
  // EmailVerificationToken para contas via email/senha.
  emailVerificadoEm DateTime?  @map("email_verificado_em")

  memberships             Membership[]
  comments                Comment[]
  // Videos em que este usuario (owner ou editor) e uma das pessoas responsaveis.
  videosResponsavel       VideoResponsavel[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  sessions                Session[]
  recordingEvents         RecordingEvent[]
  // Projetos aos quais este usuario (editor) foi atribuido
  projectMemberships      ProjectMember[]
  // Demandas (cards do board Kanban) atribuidas a este usuario
  demandasResponsavel     Demanda[]
  // Clientes pelos quais este usuario e o responsavel designado
  clientesResponsavel       Client[]
  // CrewMember(s) vinculados a esta conta (ver CrewMember.userId)
  crewMemberLinks         CrewMember[]
  // Google Calendar pessoal conectado por este usuario (ver GoogleCalendarConnection)
  googleCalendarConnection  GoogleCalendarConnection?
  googleDriveConnection     GoogleDriveConnection?
  recordingEventGoogleSyncs RecordingEventGoogleSync[]
  // Arquivos operacionais do cliente enviados por este usuario (ver ClientFile)
  clientFilesEnviados     ClientFile[]
  checkDayNotesAutor      CheckDayNote[]
  driveItemsVinculados      ProjectGoogleDriveItem[]
  videoCollaborations     VideoCollaborator[]
  demandaCollaborations   DemandaCollaborator[]

  @@map("users")
}

// Vinculo de um User a uma Account: papel (owner/editor - nunca admin, que e
// exclusivo do User.role global) e status dentro dessa agencia especifica.
// Um mesmo User pode ter varios Memberships (multi-agencia) - ver
// AuthService.resolveMemberships e o fluxo de login/select-account.
model Membership {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  accountId    String     @map("account_id")
  role         UserRole
  status       UserStatus @default(ativo)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
  @@index([userId])
  @@map("memberships")
}

// Uma linha por login bem-sucedido (email/senha, Google, Apple ou aceite de
// convite). O JWT emitido carrega o id dessa sessao como claim `sid`; o
// guard confere a cada request que ela ainda existe (revogar = apagar a
// linha). Alimenta a tela de "sessoes ativas" (listar dispositivos logados
// e permitir encerrar remotamente).
model Session {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  // String crua do header User-Agent; o "Chrome - macOS" amigavel e
  // derivado na hora de montar a resposta (nunca armazenado processado).
  userAgent      String?  @map("user_agent")
  ip             String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  ultimoAcessoEm DateTime @default(now()) @map("ultimo_acesso_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Token de uso unico para o fluxo de "esqueci minha senha". Expira em 1h
// (ver AuthService.forgotPassword); usedEm marca consumo para nao permitir
// reuso mesmo dentro da janela de validade.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @default(uuid())
  expiresEm DateTime  @map("expires_em")
  usedEm    DateTime? @map("used_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Token de uso unico para confirmar o email no cadastro (fluxo de boas-vindas).
// Expira em 7 dias (ver AuthService.sendWelcomeEmail/resendConfirmation);
// usedEm marca consumo, mesmo padrao de PasswordResetToken.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @default(uuid())
  expiresEm DateTime  @map("expires_em")
  usedEm    DateTime? @map("used_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Invite {
  id        String       @id @default(uuid())
  accountId String       @map("account_id")
  email     String
  token     String       @unique @default(uuid())
  status    InviteStatus @default(pendente)
  expiresEm DateTime     @map("expires_em")
  criadoEm  DateTime     @default(now()) @map("criado_em")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("invites")
}

// Evento do calendário de gravações (agenda da agência). Cliente e membro
// responsável são opcionais — a gravação pode ser lançada antes de ambos
// estarem definidos.
model RecordingEvent {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  titulo      String
  tipo        RecordingEventTipo @default(gravacao)
  dataInicio  DateTime  @map("data_inicio")
  dataFim     DateTime? @map("data_fim")
  clienteId   String?   @map("cliente_id")
  membroId    String?   @map("membro_id")
  demandaId   String?   @map("demanda_id")
  observacoes String?
  criadoEm    DateTime  @default(now()) @map("criado_em")

  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliente       Client?              @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  membro        User?                @relation(fields: [membroId], references: [id], onDelete: SetNull)
  demanda       Demanda?             @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  notifications Notification[]
  equipe        RecordingEventCrew[]
  googleSyncs   RecordingEventGoogleSync[]

  @@index([accountId])
  @@index([clienteId])
  @@index([membroId])
  @@index([demandaId])
  @@map("recording_events")
}

// Google Calendar pessoal conectado por um usuario (OAuth auth-code, escopo
// calendar.events) - usado pelo sync unidirecional Aprova -> Google dos
// RecordingEvent. refreshTokenEnc e criptografado antes de persistir.
model GoogleCalendarConnection {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  googleEmail     String?  @map("google_email")
  refreshTokenEnc String   @map("refresh_token_enc")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

// Conexao OAuth pessoal com o Google Drive. O refresh token e criptografado
// antes de persistir; a integracao so consulta metadados dos itens.
model GoogleDriveConnection {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  googleEmail     String?  @map("google_email")
  refreshTokenEnc String   @map("refresh_token_enc")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_drive_connections")
}

// Vinculo de uma pasta ou arquivo existente no Drive a um projeto. O conteudo
// nao e copiado para o Aprova nem tem suas permissoes alteradas.
model ProjectGoogleDriveItem {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  linkedByUserId String?  @map("linked_by_user_id")
  googleFileId   String   @map("google_file_id")
  nome           String
  mimeType       String   @map("mime_type")
  isFolder       Boolean  @default(false) @map("is_folder")
  webViewLink    String?  @map("web_view_link")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedByUser User?   @relation(fields: [linkedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, googleFileId])
  @@index([linkedByUserId])
  @@map("project_google_drive_items")
}

// Mapeia cada RecordingEvent -> evento criado no Google Calendar de cada
// destinatario, para permitir editar/apagar o evento certo no Google.
model RecordingEventGoogleSync {
  id               String   @id @default(uuid())
  recordingEventId String   @map("recording_event_id")
  userId           String   @map("user_id")
  googleEventId    String   @map("google_event_id")
  criadoEm         DateTime @default(now()) @map("criado_em")

  recordingEvent RecordingEvent @relation(fields: [recordingEventId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordingEventId, userId])
  @@index([userId])
  @@map("recording_event_google_sync")
}

// Pessoa da equipe de gravacao (freelancer, motorista etc.). Normalmente nao
// e um User do sistema, so um nome cadastrado pela agencia pra escalar em
// RecordingEvent (ver RecordingEventCrew) — mas userId pode vincular esse
// registro a uma conta real (owner/editor) quando a pessoa escalada tem
// login no Aprova, o que abre espaco pra notifica-la (ver
// NotificationsService.sendRecordingReminders). Null continua sendo o caso
// comum (freelancer, motorista etc., sem conta).
model CrewMember {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  nome      String
  userId    String?  @map("user_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  recordingEvents RecordingEventCrew[]

  @@index([accountId])
  @@index([userId])
  @@map("crew_members")
}

// Escala N:N entre RecordingEvent e CrewMember (quem participa de cada
// gravacao).
model RecordingEventCrew {
  id               String @id @default(uuid())
  recordingEventId String @map("recording_event_id")
  crewMemberId     String @map("crew_member_id")

  recordingEvent RecordingEvent @relation(fields: [recordingEventId], references: [id], onDelete: Cascade)
  crewMember     CrewMember     @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@unique([recordingEventId, crewMemberId])
  @@index([crewMemberId])
  @@map("recording_event_crew")
}

// Atribuicao de um editor a um projeto: owner sempre enxerga todos os
// projetos da conta; editor so enxerga/acessa projetos onde ha uma linha
// aqui (ver assertProjectAccess em src/common/project-access.util.ts).
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Client {
  id        String  @id @default(uuid())
  nome      String
  email     String?
  // Legenda exibida no modo "Preview Reels" da galeria publica
  descricao String?
  // Foto do cliente (avatar), exibida no modo "Preview Reels"
  fotoUrl   String? @map("foto_url")
  accountId String  @map("account_id")
  // Profissional (owner/editor) da agencia responsavel por este cliente.
  // Null quando ainda nao ha responsavel atribuido.
  responsavelId String? @map("responsavel_id")
  // Marca dados de exemplo criados no onboarding, para o usuario poder deletar
  isExemplo Boolean @default(false) @map("is_exemplo")
  // Marca propria do cliente (white-label revendido pela agencia): quando
  // setada, sobrepoe campo a campo o branding da agencia (User.logoUrl/
  // corDestaque) nos links publicos deste cliente - ver ClientsService e
  // PublicService.getProject/getPortfolio.
  logoUrl     String? @map("logo_url")
  corDestaque String? @map("cor_destaque")

  // Valores dos campos customizados definidos pela agencia. As chaves sao os
  // IDs de ClientField para que renomear um campo nao altere valores ja salvos.
  camposPersonalizados Json? @map("campos_personalizados")
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  responsavel     User?            @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  projects        Project[]
  recordingEvents RecordingEvent[]
  // Albuns de portfolio etiquetados com a marca deste cliente (ver
  // Portfolio.clienteId) - nao implica posse/restricao de acesso, so marca.
  portfolios      Portfolio[]
  demandas        Demanda[]
  activities      ClientActivity[]
  files           ClientFile[]

  @@index([accountId])
  @@index([responsavelId])
  @@map("clients")
}
// Definicao de um campo extra no cadastro de clientes, compartilhada por
// todos os membros da mesma agencia.
model ClientField {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  rotulo    String
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, ordem])
  @@map("client_fields")
}


// Trilha de auditoria append-only do cliente (central do cliente no
// frontend, GET /clients/:id/activity). Gravada automaticamente pelo
// backend nos fluxos existentes (upload de video, aprovacao/ajuste do
// cliente, comentarios, resposta da agencia, arquivos) - nunca criada
// manualmente pelo frontend.
model ClientActivity {
  id        String                 @id @default(uuid())
  accountId String                 @map("account_id")
  clienteId String                 @map("cliente_id")
  tipo      ClientActivityType
  atorTipo  ClientActivityAtorTipo @map("ator_tipo")
  // Snapshot de exibicao do autor no momento do evento (nome do
  // owner/editor, ou nome livre informado pelo cliente sem login).
  atorNome  String?                @map("ator_nome")
  videoId   String?                @map("video_id")
  projectId String?                @map("project_id")
  arquivoId String?                @map("arquivo_id")
  descricao String?
  metadados Json?
  criadoEm  DateTime               @default(now()) @map("criado_em")

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliente Client      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  video   Video?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  arquivo ClientFile? @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  @@index([clienteId, criadoEm])
  @@index([accountId])
  @@map("client_activities")
}

// Arquivo operacional do cliente (briefing, contrato, referencia, roteiro,
// logo, etc.) - distinto dos videos de aprovacao. Nunca exposto nos links
// publicos (sem controller/rota sob PublicModule).
model ClientFile {
  id           String              @id @default(uuid())
  accountId    String              @map("account_id")
  clienteId    String              @map("cliente_id")
  nomeArquivo  String              @map("nome_arquivo")
  urlStorage   String              @map("url_storage")
  mimeType     String              @map("mime_type")
  // Preenchido pelo backend via HEAD no R2 (headObject), nunca confiado
  // do valor enviado pelo cliente - ver ClientFilesService.
  tamanhoBytes Int?                @map("tamanho_bytes")
  categoria    ClientFileCategoria @default(outro)
  descricao    String?
  enviadoPorId String?             @map("enviado_por_id")
  criadoEm     DateTime            @default(now()) @map("criado_em")

  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliente    Client           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  enviadoPor User?            @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  activities ClientActivity[]

  @@index([clienteId])
  @@index([accountId])
  @@map("client_files")
}

model CheckDayNote {
  id           String                    @id @default(uuid())
  accountId    String                    @map("account_id")
  authorId     String                    @map("author_id")
  title        String
  body         String?
  items        Json                      @default("[]")
  imageUrl     String?                   @map("image_url")
  visibilidade CheckDayNoteVisibilidade @default(equipe)
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([accountId, updatedAt])
  @@index([accountId, authorId])
  @@map("checkday_notes")
}

model Project {
  id          String   @id @default(uuid())
  nome        String
  clientId    String   @map("client_id")
  accountId   String   @map("account_id")
  isExemplo   Boolean  @default(false) @map("is_exemplo")
  // Link unico da galeria publica: todos os videos do projeto num so link,
  // para o cliente nao precisar entrar video por video (ver PublicService).
  linkPublico String   @unique @default(uuid()) @map("link_publico")
  criadoEm    DateTime @default(now()) @map("criado_em")

  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videos     Video[]
  members    ProjectMember[]
  activities ClientActivity[]
  googleDriveItems ProjectGoogleDriveItem[]

  @@index([clientId])
  @@index([accountId])
  @@map("projects")
}

model Video {
  id                  String              @id @default(uuid())
  projectId           String              @map("project_id")
  urlStorage          String              @map("url_storage")
  nomeArquivo         String              @map("nome_arquivo")
  versao              Int                 @default(1)
  videoPaiId          String?             @map("video_pai_id")
  status              VideoStatus         @default(pendente)
  linkPublico         String              @unique @default(uuid()) @map("link_publico")
  // Preview do WhatsApp / Open Graph: frame extraido do video
  thumbnailUrl        String?             @map("thumbnail_url")
  // Versao comprimida para streaming web (gerada em background); original permanece em url_storage
  urlOtimizada        String?             @map("url_otimizada")
  // Duracao do video em segundos, extraida via ffprobe no pipeline de
  // processamento (nao vem do client); null ate o processamento terminar
  duracaoSegundos     Int?                @map("duracao_segundos")
  // Estado do pipeline de processamento (thumbnail + otimizacao)
  statusProcessamento ProcessamentoStatus @default(processando) @map("status_processamento")
  // Quando o cliente aprovou (para metricas de tempo de aprovacao)
  aprovadoEm          DateTime?           @map("aprovado_em")
  // Marca video de exemplo criado no onboarding
  isExemplo           Boolean             @default(false) @map("is_exemplo")
  // Prazo de entrega definido pelo owner. Visivel apenas para owner/editor —
  // NUNCA deve ser selecionado nas queries do canal publico (cliente).
  deadline            DateTime?           @map("deadline")
  // Nota geral (1-5) dada pelo cliente no momento da aprovacao. Alimenta o
  // desempenho da equipe (media por pessoa responsavel).
  notaGeral           Int?                @map("nota_geral")
  // Etapa de producao interna (board Kanban) - ver EtapaProducao.
  etapaProducao       EtapaProducao       @default(planejado) @map("etapa_producao")
  criadoEm            DateTime            @default(now()) @map("criado_em")

  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoPai          Video?           @relation("VersionHistory", fields: [videoPaiId], references: [id], onDelete: SetNull)
  versoes           Video[]          @relation("VersionHistory")
  comments          Comment[]
  ratings           Rating[]
  notifications     Notification[]
  portfolioVideos   PortfolioVideo[]
  demandas          Demanda[]
  activities        ClientActivity[]
  labels            VideoLabel[]
  collaborators     VideoCollaborator[]
  responsaveis      VideoResponsavel[]

  @@index([projectId])
  @@index([videoPaiId])
  @@map("videos")
}

enum DemandaTipo {
  projeto
  campanha
  gravacao
  demanda
}

enum RecordingEventTipo {
  gravacao
  captacao
  ensaio
  reuniao
  entrega
  prazo
  evento
  demanda_interna
}

// Card generico do board Kanban (etapa de producao), sem estar ligado a
// nenhum Video - cobre a outra metade do quadro (planejamento/campanha/
// gravacao) que o card de Video ja nao cobre. Escopo direto por conta
// (mesmo padrao de RecordingEvent/CrewMember), nao passa por Project.
model Demanda {
  id            String        @id @default(uuid())
  accountId     String        @map("account_id")
  titulo        String
  tipo          DemandaTipo
  clienteId     String?       @map("cliente_id")
  responsavelId String?       @map("responsavel_id")
  prazo         DateTime?
  etapa         EtapaProducao @default(planejado)
  // Referencia opcional a um Video - nao usado hoje, deixa a porta aberta
  // pra uma demanda "virar" ou apontar pra um video especifico no futuro.
  videoId       String?       @map("video_id")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliente     Client? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  responsavel User?   @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  video       Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  recordingEvents RecordingEvent[]
  labels          DemandaLabel[]
  collaborators   DemandaCollaborator[]

  @@index([accountId])
  @@index([clienteId])
  @@index([responsavelId])
  @@index([videoId])
  @@map("demandas")
}

// Labels compartilhadas por todos os membros de uma agencia. Nao pertencem
// ao usuario que as criou: Account e o unico escopo de isolamento.
model Label {
  id           String     @id @default(uuid())
  accountId    String     @map("account_id")
  text         String
  color        LabelColor
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videos   VideoLabel[]
  demandas DemandaLabel[]

  @@index([accountId])
  @@map("labels")
}

model VideoLabel {
  videoId String @map("video_id")
  labelId String @map("label_id")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([videoId, labelId])
  @@index([labelId])
  @@map("video_labels")
}

model DemandaLabel {
  demandaId String @map("demanda_id")
  labelId   String @map("label_id")

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([demandaId, labelId])
  @@index([labelId])
  @@map("demanda_labels")
}

// Colaborador e uma marcacao informativa de um membro da conta; nao altera
// as pessoas responsaveis do Video nem o responsavel da Demanda.
model VideoCollaborator {
  videoId String @map("video_id")
  userId  String @map("user_id")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])
  @@index([userId])
  @@map("video_collaborators")
}

// Pessoas responsaveis por um video. A associacao explicita permite que um
// video tenha mais de um owner/editor responsavel e preserva a consulta por
// pessoa usada pelo painel de desempenho.
model VideoResponsavel {
  videoId String @map("video_id")
  userId  String @map("user_id")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])
  @@index([userId])
  @@map("video_responsaveis")
}

model DemandaCollaborator {
  demandaId String @map("demanda_id")
  userId    String @map("user_id")

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([demandaId, userId])
  @@index([userId])
  @@map("demanda_collaborators")
}

// Vitrine da agencia: colecao curada manualmente pelo owner, distinta da
// galeria de projeto (Project.linkPublico) - nao espelha uma entrega, nao
// tem status de aprovacao, link publico proprio pra atrair novos clientes
// (ver PortfoliosService/PublicService.getPortfolio).
model Portfolio {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  nome         String
  descricao    String?
  linkPublico  String   @unique @default(uuid()) @map("link_publico")
  // Capa explicita do album (upload dedicado - ver POST /portfolios/:id/cover-upload-url).
  // Nulo ate o owner subir uma: nesse caso a API cai no posterUrl do primeiro
  // item (por ordem) como fallback (ver PortfoliosService.toResponse).
  capaUrl      String?  @map("capa_url")
  // Categoria do hub publico (ver PortfolioCategory) - opcional, null = sem
  // categoria (nao aparece no hub, so no link direto /p/:linkPublico).
  categoriaId  String?  @map("categoria_id")
  // Etiqueta opcional: marca este album como personalizado pra um cliente
  // especifico (ex.: selecao de cases pra reapresentar a um prospect) - so
  // sinalizacao de marca (ver Client.logoUrl/corDestaque), nao afeta quem
  // acessa o link nem dono/criador do album.
  clienteId    String?  @map("cliente_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoria PortfolioCategory? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cliente   Client?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  videos    PortfolioVideo[]

  @@index([accountId])
  @@index([categoriaId])
  @@index([clienteId])
  @@map("portfolios")
}

// Categoria livre criada pelo owner para organizar os albuns no hub publico
// (ex.: "Casamento", "Institucional") - sem valores fixos. Excluir uma
// categoria so desassocia os albuns dela (onDelete: SetNull em Portfolio.categoriaId).
model PortfolioCategory {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  nome         String
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  portfolios Portfolio[]

  @@index([accountId])
  @@map("portfolio_categories")
}

// Perfil publico unico da agencia (hub de portfolios) - 1:1 com Account.
// linkHub e gerado preguicosamente na primeira leitura autenticada (ver
// PortfolioProfileService.getOrCreate), nunca null na resposta da API.
model PortfolioProfile {
  id           String   @id @default(uuid())
  accountId    String   @unique @map("account_id")
  fotoUrl      String?  @map("foto_url")
  linkHub      String   @unique @map("link_hub")
  // Tema cosmetico opcional. String preserva os IDs publicos do frontend,
  // inclusive "editorial-escuro", que nao e um identificador valido de enum
  // no Prisma. A whitelist fica no DTO.
  templateId   String?  @map("template_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("portfolio_profiles")
}

// Item de um Portfolio. Sempre denormalizado (urlStorage/posterUrl/etc sao
// uma copia, tirada no momento em que o video entra no portfolio) - a rota
// publica nunca resolve o Video/projeto/cliente original por tras. Dois
// jeitos de entrar: referenciando um Video existente (sourceVideoId
// preenchido) ou upload dedicado direto pro portfolio (sourceVideoId nulo).
// sourceVideoId so existe pra decidir se e seguro apagar os arquivos do R2
// ao remover o item (ver PortfoliosService.removeVideo) - nunca exposto na
// API, e onDelete SetNull pra nao travar a exclusao do Video original.
model PortfolioVideo {
  id                  String              @id @default(uuid())
  portfolioId         String              @map("portfolio_id")
  sourceVideoId       String?             @map("source_video_id")
  // "foto": sem pipeline de otimizacao/thumbnail - urlStorage/urlOtimizada
  // ficam null e a propria foto vira posterUrl (ver PortfoliosService.
  // uploadComplete). "video": comportamento de sempre.
  tipoMidia           PortfolioMediaType  @default(video) @map("tipo_midia")
  titulo              String
  descricao           String?
  urlStorage          String?             @map("url_storage")
  urlOtimizada        String?             @map("url_otimizada")
  posterUrl           String?             @map("poster_url")
  statusProcessamento ProcessamentoStatus @default(processando) @map("status_processamento")
  duracaoSegundos     Int?                @map("duracao_segundos")
  ordem               Int                 @default(0)
  criadoEm            DateTime            @default(now()) @map("criado_em")

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  sourceVideo Video?    @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)

  @@index([portfolioId])
  @@index([sourceVideoId])
  @@map("portfolio_videos")
}

model Comment {
  id             String            @id @default(uuid())
  videoId        String            @map("video_id")
  timestampVideo Int               @map("timestamp_video")
  // Nulo quando o comentario e so de audio (audioUrl preenchido).
  texto          String?
  // Canal do comentario (cliente | interno) — isola as duas conversas.
  channel        CommentChannel    @default(cliente)
  // Tipo do autor (owner | editor | cliente).
  autorType      CommentAuthorType @default(cliente) @map("autor_type")
  // Autor autenticado (owner/editor); nulo quando autor_type = cliente.
  autorUserId    String?           @map("autor_user_id")
  // Nome livre do autor cliente (usado quando autor_type = cliente).
  autorNome      String?           @map("autor_nome")
  // Comentario por audio do cliente (alternativa ao texto, nao obrigatorio
  // os dois juntos). URL publica do arquivo no R2.
  audioUrl       String?           @map("audio_url")
  // Resposta em thread: aponta pro comentario pai (mesmo canal).
  // Campo exposto na API como "parentId" (front so reconhece esse nome);
  // a coluna no banco permanece parent_comment_id via @map.
  parentId       String?           @map("parent_comment_id")
  criadoEm       DateTime          @default(now()) @map("criado_em")

  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  autorUser User?     @relation(fields: [autorUserId], references: [id], onDelete: SetNull)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[] @relation("CommentThread")

  @@index([videoId])
  @@index([parentId])
  @@index([autorUserId])
  @@map("comments")
}

model Rating {
  id               String   @id @default(uuid())
  videoId          String   @map("video_id")
  ratingQuestionId String   @map("rating_question_id")
  nota             Int
  criadoEm         DateTime @default(now()) @map("criado_em")

  video          Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Restrict: nao deixa apagar uma pergunta que ja tem avaliacoes (o owner
  // deve desativa-la com `ativo: false` em vez de excluir).
  ratingQuestion RatingQuestion @relation(fields: [ratingQuestionId], references: [id], onDelete: Restrict)

  @@index([videoId])
  @@index([ratingQuestionId])
  @@map("ratings")
}

// Pergunta de avaliacao customizavel pelo owner (substitui as categorias
// fixas iluminacao/audio/enquadramento). Escopada por conta (agencia).
model RatingQuestion {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  texto     String
  // Ordem de exibicao no formulario publico do cliente.
  ordem     Int      @default(0)
  // Perguntas inativas somem do formulario publico mas os ratings ja dados
  // permanecem (por isso DELETE so e permitido sem ratings associados).
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@index([accountId])
  @@map("rating_questions")
}

// Notificacao in-app para o owner/editor responsavel ficarem cientes de
// acoes do cliente (comentario, aprovacao, ajuste, avaliacao) num video, ou
// para lembrar de uma gravacao proxima (lembrete_gravacao, videoId nulo/
// recordingEventId preenchido nesse caso) — destinatarios: todo owner da
// conta + cada CrewMember escalado no evento que tenha userId (ver
// NotificationsService.sendRecordingReminders).
model Notification {
  id               String           @id @default(uuid())
  accountId        String           @map("account_id")
  userId           String           @map("user_id")
  videoId          String?          @map("video_id")
  recordingEventId String?          @map("recording_event_id")
  type             NotificationType
  lida             Boolean          @default(false)
  criadoEm         DateTime         @default(now()) @map("criado_em")

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  recordingEvent RecordingEvent? @relation(fields: [recordingEventId], references: [id], onDelete: Cascade)

  @@unique([recordingEventId, userId, type])
  @@index([userId, lida])
  @@index([accountId])
  @@index([videoId])
  @@map("notifications")
}
