generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// admin  = administrador da plataforma (nao pertence a uma agencia)
// owner  = dono da agencia (antigo "profissional")
// editor = membro convidado da agencia
enum UserRole {
  admin
  owner
  editor
}

enum UserStatus {
  ativo
  suspenso
}

// Plano de assinatura da conta (agencia). Controla limites de uso e acesso
// a features (ver PlansService/PLAN_LIMITS em src/plans/). Sem gateway de
// pagamento integrado ainda: a troca de plano hoje e manual, via endpoint
// admin (PATCH /admin/accounts/:id/plan).
enum Plan {
  free
  pro
  agencia
}

enum VideoStatus {
  pendente
  aprovado
  ajuste
  erro
}

enum ProcessamentoStatus {
  processando
  pronto
  erro
}

enum InviteStatus {
  pendente
  aceito
  cancelado
}

// Canal do comentario: cliente (conversa com o cliente externo) e
// interno (conversa privada da agencia, nunca visivel pro cliente).
enum CommentChannel {
  cliente
  interno
}

// Quem escreveu: cliente (externo, sem login) ou owner/editor da agencia.
enum CommentAuthorType {
  owner
  editor
  cliente
}

// Eventos do cliente que geram notificacao para o owner/editor responsavel.
enum NotificationType {
  comentario_cliente
  aprovacao_cliente
  ajuste_solicitado
  avaliacao_cliente
  // Lembrete de gravacao proxima (RecordingEvent) - so pro owner, ver
  // NotificationsService.sendRecordingReminders.
  lembrete_gravacao
}

// Conta = agencia. Agrupa os usuarios (owner + editores) e todos os
// clientes/projetos compartilhados por eles.
model Account {
  id          String   @id @default(uuid())
  nomeAgencia String   @map("nome_agencia")
  plan        Plan     @default(free)
  // Assinatura paga (Mercado Pago — Preapproval). Nulo ate a primeira
  // assinatura ser criada/confirmada — ver src/billing/billing.service.ts.
  mercadopagoSubscriptionId String? @unique @map("mercadopago_subscription_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  users           User[]
  clients         Client[]
  projects        Project[]
  invites         Invite[]
  ratingQuestions RatingQuestion[]
  notifications   Notification[]
  recordingEvents RecordingEvent[]
  crewMembers     CrewMember[]

  @@map("accounts")
}

model User {
  id          String     @id @default(uuid())
  accountId   String     @map("account_id")
  nome        String
  email       String     @unique
  // Opcional: contas criadas via login social (Google/Apple) nao tem senha local.
  senha       String?
  // Identificadores de login social. Uma conta pode ter senha local e/ou
  // um ou ambos vinculados (login por qualquer um deles cai no mesmo User).
  googleId    String?    @unique @map("google_id")
  appleId     String?    @unique @map("apple_id")
  avatarUrl   String?    @map("avatar_url")
  role        UserRole   @default(owner)
  status      UserStatus @default(ativo)
  // White label da agencia: logo e cor de destaque (hex) exibidos na tela do cliente
  logoUrl     String?    @map("logo_url")
  corDestaque String?    @map("cor_destaque")
  criadoEm    DateTime   @default(now()) @map("criado_em")
  // Null = ainda nao confirmou o email. Preenchido na hora da criacao para
  // contas via Google/Apple (o provider ja verificou), ou ao consumir um
  // EmailVerificationToken para contas via email/senha.
  emailVerificadoEm DateTime? @map("email_verificado_em")

  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  comments                Comment[]
  // Videos em que este usuario (owner ou editor) e o responsavel designado
  videosResponsavel       Video[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  sessions                Session[]
  recordingEvents         RecordingEvent[]

  @@index([accountId])
  @@map("users")
}

// Uma linha por login bem-sucedido (email/senha, Google, Apple ou aceite de
// convite). O JWT emitido carrega o id dessa sessao como claim `sid`; o
// guard confere a cada request que ela ainda existe (revogar = apagar a
// linha). Alimenta a tela de "sessoes ativas" (listar dispositivos logados
// e permitir encerrar remotamente).
model Session {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  // String crua do header User-Agent; o "Chrome - macOS" amigavel e
  // derivado na hora de montar a resposta (nunca armazenado processado).
  userAgent      String?  @map("user_agent")
  ip             String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  ultimoAcessoEm DateTime @default(now()) @map("ultimo_acesso_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Token de uso unico para o fluxo de "esqueci minha senha". Expira em 1h
// (ver AuthService.forgotPassword); usedEm marca consumo para nao permitir
// reuso mesmo dentro da janela de validade.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @default(uuid())
  expiresEm DateTime  @map("expires_em")
  usedEm    DateTime? @map("used_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Token de uso unico para confirmar o email no cadastro (fluxo de boas-vindas).
// Expira em 7 dias (ver AuthService.sendWelcomeEmail/resendConfirmation);
// usedEm marca consumo, mesmo padrao de PasswordResetToken.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @default(uuid())
  expiresEm DateTime  @map("expires_em")
  usedEm    DateTime? @map("used_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Invite {
  id        String       @id @default(uuid())
  accountId String       @map("account_id")
  email     String
  token     String       @unique @default(uuid())
  status    InviteStatus @default(pendente)
  expiresEm DateTime     @map("expires_em")
  criadoEm  DateTime     @default(now()) @map("criado_em")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("invites")
}

// Evento do calendário de gravações (agenda da agência). Cliente e membro
// responsável são opcionais — a gravação pode ser lançada antes de ambos
// estarem definidos.
model RecordingEvent {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  titulo      String
  dataInicio  DateTime  @map("data_inicio")
  dataFim     DateTime? @map("data_fim")
  clienteId   String?   @map("cliente_id")
  membroId    String?   @map("membro_id")
  observacoes String?
  criadoEm    DateTime  @default(now()) @map("criado_em")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliente       Client?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  membro        User?          @relation(fields: [membroId], references: [id], onDelete: SetNull)
  notifications Notification[]
  equipe        RecordingEventCrew[]

  @@index([accountId])
  @@index([clienteId])
  @@index([membroId])
  @@map("recording_events")
}

// Pessoa da equipe de gravacao (freelancer, motorista etc.) — nao e um
// User do sistema, so um nome cadastrado pela agencia pra escalar em
// RecordingEvent (ver RecordingEventCrew).
model CrewMember {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  nome      String
  criadoEm  DateTime @default(now()) @map("criado_em")

  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordingEvents RecordingEventCrew[]

  @@index([accountId])
  @@map("crew_members")
}

// Escala N:N entre RecordingEvent e CrewMember (quem participa de cada
// gravacao).
model RecordingEventCrew {
  id               String @id @default(uuid())
  recordingEventId String @map("recording_event_id")
  crewMemberId     String @map("crew_member_id")

  recordingEvent RecordingEvent @relation(fields: [recordingEventId], references: [id], onDelete: Cascade)
  crewMember     CrewMember     @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@unique([recordingEventId, crewMemberId])
  @@index([crewMemberId])
  @@map("recording_event_crew")
}

model Client {
  id        String  @id @default(uuid())
  nome      String
  email     String?
  // Legenda exibida no modo "Preview Reels" da galeria publica
  descricao String?
  // Foto do cliente (avatar), exibida no modo "Preview Reels"
  fotoUrl   String? @map("foto_url")
  accountId String  @map("account_id")
  // Marca dados de exemplo criados no onboarding, para o usuario poder deletar
  isExemplo Boolean @default(false) @map("is_exemplo")

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projects        Project[]
  recordingEvents RecordingEvent[]

  @@index([accountId])
  @@map("clients")
}

model Project {
  id          String   @id @default(uuid())
  nome        String
  clientId    String   @map("client_id")
  accountId   String   @map("account_id")
  isExemplo   Boolean  @default(false) @map("is_exemplo")
  // Link unico da galeria publica: todos os videos do projeto num so link,
  // para o cliente nao precisar entrar video por video (ver PublicService).
  linkPublico String   @unique @default(uuid()) @map("link_publico")
  criadoEm    DateTime @default(now()) @map("criado_em")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videos  Video[]

  @@index([clientId])
  @@index([accountId])
  @@map("projects")
}

model Video {
  id                  String              @id @default(uuid())
  projectId           String              @map("project_id")
  urlStorage          String              @map("url_storage")
  nomeArquivo         String              @map("nome_arquivo")
  versao              Int                 @default(1)
  videoPaiId          String?             @map("video_pai_id")
  status              VideoStatus         @default(pendente)
  linkPublico         String              @unique @default(uuid()) @map("link_publico")
  // Preview do WhatsApp / Open Graph: frame extraido do video
  thumbnailUrl        String?             @map("thumbnail_url")
  // Versao comprimida para streaming web (gerada em background); original permanece em url_storage
  urlOtimizada        String?             @map("url_otimizada")
  // Duracao do video em segundos, extraida via ffprobe no pipeline de
  // processamento (nao vem do client); null ate o processamento terminar
  duracaoSegundos     Int?                @map("duracao_segundos")
  // Estado do pipeline de processamento (thumbnail + otimizacao)
  statusProcessamento ProcessamentoStatus @default(processando) @map("status_processamento")
  // Quando o cliente aprovou (para metricas de tempo de aprovacao)
  aprovadoEm          DateTime?           @map("aprovado_em")
  // Marca video de exemplo criado no onboarding
  isExemplo           Boolean             @default(false) @map("is_exemplo")
  // Prazo de entrega definido pelo owner. Visivel apenas para owner/editor —
  // NUNCA deve ser selecionado nas queries do canal publico (cliente).
  deadline            DateTime?           @map("deadline")
  // Editor (ou owner) da conta responsavel por este video. Definido pelo owner.
  editorResponsavelId String?             @map("editor_responsavel_id")
  // Nota geral (1-5) dada pelo cliente no momento da aprovacao. Alimenta o
  // desempenho da equipe (media por editor responsavel).
  notaGeral           Int?                @map("nota_geral")
  criadoEm            DateTime            @default(now()) @map("criado_em")

  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoPai          Video?         @relation("VersionHistory", fields: [videoPaiId], references: [id], onDelete: SetNull)
  versoes           Video[]        @relation("VersionHistory")
  comments          Comment[]
  ratings           Rating[]
  editorResponsavel User?          @relation(fields: [editorResponsavelId], references: [id], onDelete: SetNull)
  notifications     Notification[]

  @@index([projectId])
  @@index([videoPaiId])
  @@index([editorResponsavelId])
  @@map("videos")
}

model Comment {
  id             String            @id @default(uuid())
  videoId        String            @map("video_id")
  timestampVideo Int               @map("timestamp_video")
  // Nulo quando o comentario e so de audio (audioUrl preenchido).
  texto          String?
  // Canal do comentario (cliente | interno) — isola as duas conversas.
  channel        CommentChannel    @default(cliente)
  // Tipo do autor (owner | editor | cliente).
  autorType      CommentAuthorType @default(cliente) @map("autor_type")
  // Autor autenticado (owner/editor); nulo quando autor_type = cliente.
  autorUserId    String?           @map("autor_user_id")
  // Nome livre do autor cliente (usado quando autor_type = cliente).
  autorNome      String?           @map("autor_nome")
  // Comentario por audio do cliente (alternativa ao texto, nao obrigatorio
  // os dois juntos). URL publica do arquivo no R2.
  audioUrl       String?           @map("audio_url")
  // Resposta em thread: aponta pro comentario pai (mesmo canal).
  // Campo exposto na API como "parentId" (front so reconhece esse nome);
  // a coluna no banco permanece parent_comment_id via @map.
  parentId       String?           @map("parent_comment_id")
  criadoEm       DateTime          @default(now()) @map("criado_em")

  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  autorUser User?     @relation(fields: [autorUserId], references: [id], onDelete: SetNull)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[] @relation("CommentThread")

  @@index([videoId])
  @@index([parentId])
  @@index([autorUserId])
  @@map("comments")
}

model Rating {
  id               String   @id @default(uuid())
  videoId          String   @map("video_id")
  ratingQuestionId String   @map("rating_question_id")
  nota             Int
  criadoEm         DateTime @default(now()) @map("criado_em")

  video          Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Restrict: nao deixa apagar uma pergunta que ja tem avaliacoes (o owner
  // deve desativa-la com `ativo: false` em vez de excluir).
  ratingQuestion RatingQuestion @relation(fields: [ratingQuestionId], references: [id], onDelete: Restrict)

  @@index([videoId])
  @@index([ratingQuestionId])
  @@map("ratings")
}

// Pergunta de avaliacao customizavel pelo owner (substitui as categorias
// fixas iluminacao/audio/enquadramento). Escopada por conta (agencia).
model RatingQuestion {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  texto     String
  // Ordem de exibicao no formulario publico do cliente.
  ordem     Int      @default(0)
  // Perguntas inativas somem do formulario publico mas os ratings ja dados
  // permanecem (por isso DELETE so e permitido sem ratings associados).
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@index([accountId])
  @@map("rating_questions")
}

// Notificacao in-app para o owner/editor responsavel ficarem cientes de
// acoes do cliente (comentario, aprovacao, ajuste, avaliacao) num video, ou
// para o owner ser lembrado de uma gravacao proxima (lembrete_gravacao,
// videoId nulo/recordingEventId preenchido nesse caso).
model Notification {
  id               String           @id @default(uuid())
  accountId        String           @map("account_id")
  userId           String           @map("user_id")
  videoId          String?          @map("video_id")
  recordingEventId String?          @map("recording_event_id")
  type             NotificationType
  lida             Boolean          @default(false)
  criadoEm         DateTime         @default(now()) @map("criado_em")

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  recordingEvent RecordingEvent? @relation(fields: [recordingEventId], references: [id], onDelete: Cascade)

  @@unique([recordingEventId, userId, type])
  @@index([userId, lida])
  @@index([accountId])
  @@index([videoId])
  @@map("notifications")
}
