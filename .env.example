# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aprova?schema=public"

# JWT
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
JWT_EXPIRES_IN="7d"

# Login social (POST /auth/google e POST /auth/apple). O client (app/frontend)
# faz o sign-in nativo e envia o token para o backend validar - sem isso
# configurado, o endpoint responde 403.
# Google: Client ID(s) do Google Cloud Console (OAuth consent). Aceita varios
# separados por virgula (ex: um client ID Web + um iOS + um Android do mesmo projeto).
GOOGLE_CLIENT_ID=""
# Apple: Bundle ID (app nativo) e/ou Services ID (web), separados por virgula.
APPLE_CLIENT_ID=""

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="sua-access-key"
R2_SECRET_ACCESS_KEY="sua-secret-key"
R2_BUCKET_NAME="aprova-videos"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# URL publica do bucket (dominio publico do R2 ou custom domain) usada para servir os videos
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# E-mail transacional (Resend) - usado para reenviar o e-mail de convite
# (POST /account/invite/:id/send-email) e para o fluxo de esqueci minha
# senha (POST /auth/forgot-password). Sem RESEND_API_KEY, o envio e apenas
# simulado via log (mesmo comportamento do inviteUrl no POST /account/invite).
RESEND_API_KEY=""
MAIL_FROM="Vistoow <no-reply@aprova.app>"

# Pagamento (Asaas) - checkout de assinatura Pro/Agencia (Customer +
# Subscription) e webhook. Sem ASAAS_API_KEY, POST /billing/checkout falha
# com 502. Gerado em "Integracoes > API" no painel Asaas.
ASAAS_API_KEY=""
# sandbox (https://api-sandbox.asaas.com) ou production (https://api.asaas.com).
# Default: sandbox se nao definido.
ASAAS_ENV="sandbox"
# Token configurado ao registrar o webhook no painel Asaas (Integracoes >
# Webhooks), enviado de volta no header "asaas-access-token" a cada notificacao.
ASAAS_WEBHOOK_TOKEN=""

# Redis (fila BullMQ do processamento de video: thumbnail + versao otimizada)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# Opcional, deixe vazio se o Redis nao exigir senha
REDIS_PASSWORD=""
# Quantos videos o worker processa (download + ffmpeg + upload) em
# paralelo por instancia. Default: 2.
VIDEO_PROCESSING_CONCURRENCY=2
# Tamanho maximo aceito para um upload de video, em MB. Default: 2048 (2 GB).
VIDEO_MAX_SIZE_MB=2048

# Onboarding: asset de demonstracao fixo (hospedado no R2) usado no video de exemplo
DEMO_VIDEO_URL="https://demo.aprova.app/exemplo/video-exemplo.mp4"
DEMO_THUMBNAIL_URL="https://demo.aprova.app/exemplo/video-exemplo.jpg"

# Admin da plataforma (usado apenas pelo script `npm run prisma:seed`;
# o POST /auth/register publico nunca cria admin, so owner)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOME="Admin"

# App
# NODE_ENV=production desabilita o Swagger (/api/docs) por padrao.
# Defina SWAGGER_ENABLED=true para forcar a exposicao mesmo em producao.
NODE_ENV="development"
SWAGGER_ENABLED=""
PORT=3000
# Origem(ns) do frontend permitida(s) no CORS. Separe multiplas por virgula,
# ex: "https://app.exemplo.com,http://localhost:3000,http://127.0.0.1:3000".
# Para testar o frontend local contra um backend ja deployado (Railway),
# adicione a origem local (http://localhost:3000 e/ou 127.0.0.1:3000) na
# env var CORS_ORIGIN do servico no Railway - nao ha nada a mudar no codigo.
CORS_ORIGIN="http://localhost:5173"
